# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (将来差し替え: OpenAI / Anthropic / Gemini など)
AI_PROVIDER=mock
AI_API_KEY=

# 広告 (Capacitor + AdMob)
NEXT_PUBLIC_ADS_ENABLED=true
# false にすると本番 ID を使用、未設定または true でテスト広告 ID にフォールバック
NEXT_PUBLIC_ADMOB_USE_TEST_IDS=true
# Android 本番広告 Unit ID (AdMob 承認後に設定)
NEXT_PUBLIC_ADMOB_ANDROID_BANNER=
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
NEXT_PUBLIC_ADMOB_ANDROID_REWARDED=
# iOS 本番広告 Unit ID
NEXT_PUBLIC_ADMOB_IOS_BANNER=
NEXT_PUBLIC_ADMOB_IOS_INTERSTITIAL=
NEXT_PUBLIC_ADMOB_IOS_REWARDED=
# AdMob App ID (AndroidManifest.xml / Info.plist にも書き込まれる)
NEXT_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
NEXT_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458502117

# Capacitor server.url 上書き (デフォルトは NEXT_PUBLIC_SITE_URL 経由で本番)
# CAP_SERVER_URL=http://192.168.x.x:3000

# 管理者
ADMIN_EMAILS=admin@example.com
