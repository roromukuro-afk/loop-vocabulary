  "commandAllowlist": {
    "note": "エージェント(engineering-agent.mjs / claim-and-run.mjs)がsh()経由で実行してよいコマンドの固定リスト。issue本文・evidence・外部ページ内容など信頼できない入力からコマンド文字列を組み立てて実行することは一切行わない(コマンド名・主要引数は常にコード内のリテラル)。",
    "commands": [
      "git checkout -b <branch> origin/main",
      "git fetch origin <branch> main",
      "git checkout <branch>",
      "git reset --hard origin/<branch>",
      "git diff --name-only|--shortstat origin/main <ref>",
      "git add <fixed path>",
      "git commit -m <fixed message>",
      "git push -u origin <branch>",
      "git ls-remote --heads origin <branch>",
      "git rev-parse HEAD",
      "npx tsc --noEmit",
      "npm run build",
      "npm run <name from package.json scripts のみ>",
      "gh pr create --draft --base main --head <branch> --title <fixed> --body <fixed>",
      "git add -A (patch-agent.mjs、専用worktree内のみ)",
      "git commit -m <fixed template>(patch-agent.mjs)",
      "git worktree add|remove(workdir.mjs、専用worktree作成・削除専用)"
    ]
  },
  "allowedPathPatternsByCategory": {
    "reliability": ["src/app/api/", "src/lib/", "scripts/testing/"],
